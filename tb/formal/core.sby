# riscv_core's own properties -- the `ifdef FORMAL block in
# rtl/core/riscv_core.sv -- under the environment in core_formal.sv.
# See regfile_x0.sby for what the two tasks mean. RISCV_FORMAL as well as
# FORMAL: the forwarding properties use the RVFI valid bits to skip bubbles.
# The *_wait tasks build the core with MEM_WAIT (Phase G). prove_wait: every
# property and H1 (a held cycle changes nothing) by k-induction, holds in any
# cycle but one at a time (core_formal.sv HOLD1) -- with H1, sound for holds
# of any length; depth 20, as holds leave fewer real steps in the window.
# bmc_wait: holds completely free, bounded from reset; depth 14 (~1.5 min;
# each step doubles, 15 took 3 min, 16 over 10; 0-15 passed, 2026-11-04).
# The *_m tasks build the core with M_EXT (Phase H): every property above
# plus M1-M3 (the M stall), I1 and B3, with muldiv_stub.sv in place of the
# unit -- the real handshake, any result, done 3 to 5 cycles into EX. With
# M2, sound for stalls of any length (muldiv_stub.sv says why); the unit's
# own latency, handshake and arithmetic are muldiv.sby's.
# prove_m_wait: M and MEM_WAIT together, holds as prove_wait's;
# cover_m_wait reaches its covers (M4 among them), holds free.
# Engine bitwuzla for them: yices sat in prove_m's base case for over 10
# minutes (step 6, 2026-11-06); bitwuzla proves it in about 5 s.

[tasks]
prove yices
cover yices
prove_wait prove yices
bmc_wait bmc yices
cover_wait cover yices
prove_m prove bitwuzla
cover_m cover bitwuzla
prove_m_wait prove bitwuzla
cover_m_wait cover bitwuzla

[options]
prove: mode prove
cover: mode cover
bmc: mode bmc
prove: depth 10
cover: depth 10
bmc_wait: depth 14
prove_wait: depth 20
prove_m_wait: depth 20

[engines]
yices: smtbmc yices
bitwuzla: smtbmc bitwuzla

[script]
read_verilog -sv -formal -DRISCV_FORMAL riscv_alu.sv riscv_branch.sv riscv_decoder.sv
read_verilog -sv -formal -DRISCV_FORMAL riscv_hazard.sv riscv_mem_align.sv riscv_regfile.sv
prove_m: read_verilog -sv -formal muldiv_stub.sv
cover_m: read_verilog -sv -formal muldiv_stub.sv
prove_m_wait: read_verilog -sv -formal muldiv_stub.sv
cover_m_wait: read_verilog -sv -formal muldiv_stub.sv
read_verilog -sv -formal -DRISCV_FORMAL riscv_core.sv core_formal.sv
prove_m: chparam -set M 1 core_formal
cover_m: chparam -set M 1 core_formal
prove_m_wait: chparam -set M 1 -set WAIT 1 -set HOLD1 1 core_formal
cover_m_wait: chparam -set M 1 -set WAIT 1 core_formal
prove_wait: chparam -set WAIT 1 -set HOLD1 1 core_formal
bmc_wait: chparam -set WAIT 1 core_formal
cover_wait: chparam -set WAIT 1 core_formal
prep -top core_formal

