+    /// Extend the sparse detections with 64 patterns at once
+    fn extend_detections(v: &mut Vec<Vec<u32>>, added: Vec<u64>) {
+        let mut lists = vec![Vec::new(); 64];
+        for (f, d) in added.iter().enumerate() {
+            if *d != 0 {
+                for i in 0..64 {
+                    if (d >> i) & 1 != 0 {
+                        lists[i].push(f as u32);
+                    }
+                }
+            }
+        }
+        v.extend(lists);
+    }
